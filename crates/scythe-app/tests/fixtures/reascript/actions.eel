GetExtState(#out, "wp12", "out");
f = strlen(#out) ? fopen(#out, "w") : 0;
function w(s) ( f ? fwrite(f, s, strlen(s)) : ShowConsoleMsg(s); );
two = NamedCommandLookup("_wp12two");
loop = NamedCommandLookup("_wp12loop");
sprintf(#s, "lookup %d %d %d %d\n", two > 0, loop > two, NamedCommandLookup("40001"), NamedCommandLookup("wp12two")); w(#s);
ReverseNamedCommandLookup(#r, two); sprintf(#s, "reverse %s\n", #r); w(#s);
kbd_getTextFromCmd(#n, 40001, 0); sprintf(#s, "name %s\n", #n); w(#s);
sec = SectionFromUniqueID(0);
GetActionShortcutDesc(sec, 40001, 1, #d); sprintf(#s, "key %d %s %d\n", CountActionShortcuts(sec, 40001), #d, CountActionShortcuts(0, 40001)); w(#s);
sprintf(#s, "tog %d %d %d\n", GetToggleCommandState(1068), GetToggleCommandState(loop), GetToggleCommandStateEx(0, two)); w(#s);
Main_OnCommand(loop, 0);
sprintf(#s, "tog %d %d\n", GetToggleCommandState(1068), GetToggleCommandState(loop)); w(#s);
Main_OnCommand(loop, 0);
Main_OnCommand(two, 0);
sprintf(#s, "tracks %d\n", CountTracks(0)); w(#s);
tr = GetTrack(0, 0);
GetSetMediaTrackInfo_String(tr, "P_NAME", #nm = "Lead", 1);
GetTrackStateChunk(tr, #c, 0);
sprintf(#s, "chunk %d\n", strncmp(#c, "<TRACK", 6) == 0); w(#s);
#c2 = "<TRACK\nNAME Bass\n<ITEM\nPOSITION 2\nLENGTH 1\n>\n>\n";
sprintf(#s, "set %d %d\n", SetTrackStateChunk(tr, #c2, 0), CountTrackMediaItems(tr)); w(#s);
GetTrackName(tr, #tn); sprintf(#s, "name %s\n", #tn); w(#s);
it = GetTrackMediaItem(tr, 0);
GetItemStateChunk(it, #ic, 0);
sprintf(#s, "item %d %g %g\n", strncmp(#ic, "<ITEM", 5) == 0, GetMediaItemInfo_Value(it, "D_POSITION"), GetMediaItemInfo_Value(it, "D_LENGTH")); w(#s);
SetMouseModifier("MM_CTX_TRACK_CLK", 2, "1068");
GetMouseModifier("MM_CTX_TRACK_CLK", 2, #mm); sprintf(#s, "mm [%s]\n", #mm); w(#s);
genGuid(#g); sprintf(#s, "guid %d\n", strlen(#g)); w(#s);
sprintf(#s, "solo %d\n", AnyTrackSolo(0)); w(#s);
f ? (fclose(f); Main_OnCommand(40004, 0));
